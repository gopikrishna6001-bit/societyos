# Copy to .env.local. Never commit .env.local.
# Society OS is https://wzchqxwwezklxsxmjvyt.supabase.co. It is resumed. Apply the foundation migration before sign-in can succeed.
# Create a new Supabase project and paste its API settings here.
# Use the anon or publishable key only. Never put the service-role key in frontend env.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional override for the legacy phone/PIN edge function.
# When empty, the legacy screen calls ${VITE_SUPABASE_URL}/functions/v1/auth-login.
VITE_AUTH_URL=

# Legacy screens still read this id. The new platform uses the signed-in membership instead.
VITE_SOCIETY_ID=

# Used only by npm run seed:demo. Never prefix the service-role key with VITE_.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
