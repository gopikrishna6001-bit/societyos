{
  "name": "sabha",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "turbo run build && node scripts/prepare-cloudflare-pages.mjs",
    "dev": "turbo watch dev",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "pages:build": "pnpm --filter @sabha/shared build && pnpm --filter @sabha/web build && node scripts/prepare-cloudflare-pages.mjs"
  },
  "devDependencies": {
    "prettier": "^3.8.0",
    "turbo": "^2.7.5"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide",
      "workerd"
    ],
    "overrides": {
      "lightningcss": "1.30.1",
      "react-native-worklets": "0.10.1"
    }
  }
}
